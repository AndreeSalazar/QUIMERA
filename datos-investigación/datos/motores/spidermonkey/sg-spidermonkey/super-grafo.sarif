              }
            },
            {
              "fullDescription": {
                "text": "Hilos modifican el mismo escalar sin sincronizacion."
              },
              "help": {
                "text": "Control valido: atomic_int count; /* inicializar y usar atomic_fetch_add */\nLimite: Los atomicos requieren inicializacion y un orden de memoria adecuado al algoritmo."
              },
              "helpUri": "https://www.open-std.org/jtc1/sc22/wg14/www/docs/n1570.pdf",
